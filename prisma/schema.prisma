datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  TECHNICIAN
}

enum StudioStatus {
  AVAILABLE
  MAINTENANCE
}

enum GearKitStatus {
  AVAILABLE
  MAINTENANCE
  DAMAGED
}

enum BookingStatus {
  BOOKED
  CHECKED_OUT
  RETURNED
  CANCELLED
  NO_SHOW
}

enum InspectionCondition {
  GOOD_CONDITION
  CONSUMABLES_REPLACED
  DAMAGE_FLAGGED
}

model User {
  id                      String        @id @default(cuid())
  email                   String        @unique
  name                    String
  studentId               String?       @unique
  passwordHash            String
  role                    UserRole      @default(STUDENT)
  phone                   String?
  department              String?       @default("Film & Television Production")
  station                 String?
  shiftStatus             String?       @default("ON_DUTY")
  bio                     String?
  safetySigned            Boolean       @default(true)
  notifySessionReminders  Boolean       @default(true)
  notifyCancellationCutoff Boolean      @default(true)
  notifyGearReady         Boolean       @default(true)
  bookings                Booking[]
  inspections             Inspection[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model Studio {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  status      StudioStatus  @default(AVAILABLE)
  capacity    Int           @default(4)
  bookings    Booking[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GearKit {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String
  items       String[]
  status      GearKitStatus @default(AVAILABLE)
  bookings    Booking[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Booking {
  id              String         @id @default(cuid())
  voucherCode     String         @unique
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studioId        String
  studio          Studio         @relation(fields: [studioId], references: [id], onDelete: Restrict)
  gearKitId       String?
  gearKit         GearKit?       @relation(fields: [gearKitId], references: [id], onDelete: SetNull)
  date            String         // ISO Date format: YYYY-MM-DD
  startTime       String         // Format: HH:mm (e.g. 08:00, 10:00)
  endTime         String         // Format: HH:mm (e.g. 10:00, 12:00)
  projectTitle    String
  crewSize        Int            @default(1)
  agreementSigned Boolean        @default(false)
  status          BookingStatus  @default(BOOKED)
  inspection      Inspection?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([studioId, date, startTime])
  @@index([gearKitId, date, startTime])
  @@index([userId, date])
}

model Inspection {
  id              String              @id @default(cuid())
  bookingId       String              @unique
  booking         Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  technicianId    String
  technician      User                @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  condition       InspectionCondition @default(GOOD_CONDITION)
  notes           String?
  flaggedDamage   Boolean             @default(false)
  inspectedAt     DateTime            @default(now())
}
